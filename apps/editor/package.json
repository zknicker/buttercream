{
  "name": "@buttercream/editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply buttercream-production --local",
    "db:migrate:remote": "wrangler d1 migrations apply buttercream-production --remote",
    "deploy": "bun run build && wrangler deploy",
    "dev": "BUTTERCREAM_REMOTE_DB=1 vite dev",
    "dev:local": "vite dev",
    "preview": "vite preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@buttercream/react": "workspace:*",
    "@buttercream/styles": "workspace:*",
    "@buttercream/theme-core": "workspace:*",
    "@clerk/tanstack-react-start": "1.4.23",
    "@hugeicons-pro/core-bulk-rounded": "4.2.3",
    "@hugeicons-pro/core-duotone-rounded": "4.2.3",
    "@hugeicons-pro/core-duotone-standard": "4.2.3",
    "@hugeicons-pro/core-solid-rounded": "4.2.3",
    "@hugeicons-pro/core-solid-sharp": "4.2.3",
    "@hugeicons-pro/core-solid-standard": "4.2.3",
    "@hugeicons-pro/core-stroke-rounded": "4.2.3",
    "@hugeicons-pro/core-stroke-sharp": "4.2.3",
    "@hugeicons-pro/core-stroke-standard": "4.2.3",
    "@hugeicons-pro/core-twotone-rounded": "4.2.3",
