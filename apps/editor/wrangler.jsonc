{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buttercream-studio",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "buttercream.studio",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buttercream-production",
      "database_id": "ebd145ed-ce4d-46f9-99e8-9e7b3baeb035",
      // Local dev uses miniflare's own D1. Setting "remote" here would point `vite dev` at the
      // production database — reads and writes both — and would block worker startup on a
      // network handshake before serving anything. Run `bun run db:migrate:local` to create
      // the local copy; deploys are unaffected and always use the real database.
      "migrations_dir": "drizzle"
    }
  ]
}
