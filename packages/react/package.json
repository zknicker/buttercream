{
  "name": "@buttercream/react",
  "version": "0.1.0",
  "description": "Composable Buttercream React components",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
