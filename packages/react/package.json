      "types": "./dist/charts/index.d.mts",
      "import": "./dist/charts/index.mjs"
    },
    "./avatar": {
      "types": "./dist/avatar.d.mts",
      "import": "./dist/avatar.mjs"
    },
    "./button": {
      "types": "./dist/button.d.mts",
      "import": "./dist/button.mjs"
    },
    "./card": {
      "types": "./dist/card.d.mts",
      "import": "./dist/card.mjs"
    },
    "./checkbox": {
      "types": "./dist/checkbox.d.mts",
      "import": "./dist/checkbox.mjs"
    },
    "./drawer": {
      "types": "./dist/drawer.d.mts",
      "import": "./dist/drawer.mjs"
    },
    "./input": {
      "types": "./dist/input.d.mts",
      "import": "./dist/input.mjs"
    },
    "./modal": {
      "types": "./dist/modal.d.mts",
      "import": "./dist/modal.mjs"
    },
    "./popover": {
      "types": "./dist/popover.d.mts",
      "import": "./dist/popover.mjs"
    },
    "./radio-group": {
      "types": "./dist/radio-group.d.mts",
      "import": "./dist/radio-group.mjs"
    },
    "./select": {
      "types": "./dist/select.d.mts",
      "import": "./dist/select.mjs"
    },
    "./slider": {
      "types": "./dist/slider.d.mts",
      "import": "./dist/slider.mjs"
    },
    "./surface": {
      "types": "./dist/surface.d.mts",
      "import": "./dist/surface.mjs"
    },
    "./switch": {
      "types": "./dist/switch.d.mts",
      "import": "./dist/switch.mjs"
    },
    "./tabs": {
      "types": "./dist/tabs.d.mts",
      "import": "./dist/tabs.mjs"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.mts",
      "import": "./dist/tooltip.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.charts.json"
