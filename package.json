{
  "name": "buttercream",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build && bun run --filter @buttercream/editor build",
    "changeset": "changeset",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "dev": "bun --cwd apps/editor dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@changesets/cli": "2.31.1",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
