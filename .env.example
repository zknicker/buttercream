# Copy to .env and fill in. One file per checkout: apps/editor/.env.local links here, and a new
# worktree is seeded by copying this checkout's .env — see scripts/bootstrap-checkout.sh.

# Private registry auth, read by bunfig.toml at install time.
HUGEICONS_LICENSE_KEY=

# Clerk. The VITE_ pair reaches the browser; the rest are worker bindings read server-side.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Dev-only auto sign-in, so a local session does not need the hosted sign-in flow.
VITE_DEV_CLERK_AUTO_SIGN_IN=
DEV_CLERK_SIGN_IN_USER_ID=

# Only the CLI reads this, for the hosted export API. The editor runs without it.
BUTTERCREAM_API_KEY=
